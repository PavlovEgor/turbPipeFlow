FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      bounded Gauss upwind;

    turbulence      bounded Gauss upwind;
    "div\(phi,(epsilon|omega|nuTilda|phit)\)"            $turbulence;
    "div\(phi,(k|kl|kt)\)"            $turbulence;

    div(phi,R)      $turbulence;
    div(R)          Gauss linear;

    div(nonlinearStress) Gauss;

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited corrected 0.33;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.33;
}

wallDist
{
    method meshWave;
}
